# Xwift Local Testnet Environment Variables
# Copy this file to .env and update MINER_ADDRESS before running start-testnet.sh

# Wallet address that receives block rewards on the mining node (REQUIRED)
MINER_ADDRESS=

# Mining thread count (keep at 2-4 threads to stay within CPU budget)
MINING_THREADS=4

# Optional tags used by scripts/reporting
testnet_owner=local-validator
hardware_label=ryzen5-7600
