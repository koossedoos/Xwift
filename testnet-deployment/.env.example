# Xwift Testnet Deployment Environment Variables
# Copy this file to .env and fill in your credentials

# Digital Ocean
digitalocean_token=""
digitalocean_default_region="nyc3"
digitalocean_default_size="s-2vcpu-4gb"

# Linode
linode_token=""
linode_default_region="eu-central"
linode_default_type="g6-standard-4"

# Vultr
vultr_token=""
vultr_default_region="sgp"
vultr_default_plan="vc2-4c-8gb"

# Generic SSH configuration
ssh_user="root"
ssh_key_path="$HOME/.ssh/id_ed25519"
ssh_port=22

# Default Xwift configuration
xwift_p2p_port=29080
xwift_rpc_port=29081
xwift_zmq_port=29082

# Seed nodes
seed1_hostname="seed1.xwift-testnet.network"
seed2_hostname="seed2.xwift-testnet.network"
seed3_hostname="seed3.xwift-testnet.network"

# Monitoring
metrics_output_dir="$PWD/reports"

